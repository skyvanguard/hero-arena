[gd_resource type="Resource" script_class="HeroData" load_steps=6 format=3]

[ext_resource type="Script" path="res://content/heroes/hero_data.gd" id="1_hd"]
[ext_resource type="Script" path="res://content/heroes/passive_data.gd" id="2_pd"]
[ext_resource type="Script" path="res://content/heroes/ability_data.gd" id="3_ad"]

[sub_resource type="Resource" script_class="PassiveData" id="Resource_veilstacks"]
script = ExtResource("2_pd")
id = "veil_stacks"
display_name = "Veil Stacks"
kind = 0
params = {
"stack_hits": 6,
"window": 2.2,
"tiers": Array[Dictionary]([{"speed_mult": 1.04, "spread_mult": 0.92}, {"speed_mult": 1.08, "spread_mult": 0.84}])
}

[sub_resource type="Resource" script_class="AbilityData" id="Resource_smokestep"]
script = ExtResource("3_ad")
id = "smoke_step"
display_name = "Smoke Step"
kind = 0
cooldown = 6.5
is_ult = false
params = {"count": 2, "distance": 4.0, "speed": 15.0}

[sub_resource type="Resource" script_class="AbilityData" id="Resource_emberward"]
script = ExtResource("3_ad")
id = "ember_ward"
display_name = "Ember Ward"
kind = 1
cooldown = 8.0
is_ult = false
params = {"pellets": 3, "cone_deg": 14.0, "damage": 10.0, "slow_ratio": 0.3, "slow_duration": 2.5}

[sub_resource type="Resource" script_class="AbilityData" id="Resource_vanta_veil"]
script = ExtResource("3_ad")
id = "vanta_veil"
display_name = "Vanta's Veil"
kind = 2
cooldown = 0.0
is_ult = true
params = {"duration": 4.5, "fire_rate_mult": 1.5, "speed_mult": 1.25, "damage_mult": 1.3, "spread_mult": 0.35}

[resource]
script = ExtResource("1_hd")
id = "vanta"
display_name = "Vanta"
role = 3
sub_role = 0
color = Color(0.45, 0.3, 0.62, 1)
max_hp = 110
base_speed = 6.4
jump_velocity = 5.6
weapon = {
"clip_size": 32,
"damage": 9.0,
"fire_rate": 7.5,
"headshot_mult": 2.2,
"max_range": 110.0,
"reload_time": 1.8,
"spread_deg": 0.5
}
passive = SubResource("Resource_veilstacks")
abilities = Array[Resource]([SubResource("Resource_smokestep"), SubResource("Resource_emberward")])
ult = SubResource("Resource_vanta_veil")
ult_max = 100.0
charge_per_damage_dealt = 0.35
charge_per_damage_taken = 0.1
charge_per_kill = 15.0
