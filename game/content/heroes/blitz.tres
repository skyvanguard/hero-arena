cooldown = 0.0
is_ult = true
params = {"duration": 6.0, "fire_rate_mult": 1.8, "speed_mult": 1.5, "damage_mult": 1.3, "spread_mult": 0.8}

[resource]
script = ExtResource("1_hd")
id = "blitz"
display_name = "Blitz"
role = 0
sub_role = 1
color = Color(0.95, 0.72, 0.2, 1)
max_hp = 100
base_speed = 7.0
jump_velocity = 5.8
weapon = {
"mode": "projectile",
"clip_size": 42,
"damage": 5.0,
"fire_rate": 14.0,
"headshot_mult": 1.5,
"max_range": 45.0,
"proj_range": 40.0,
